# Fase C · Pipeline de casos con Supabase (opcional)
# Copia a ".env" y completa si quieres que "npm run casos:web" sincronice
# los casos capturados con una base Supabase (tabla: casos_web).

# URL del proyecto (Panel → Settings → API)
SUPABASE_URL=

# Anon (lectura/publicación con RLS) o Service Role (escritura total).
# Usa ANON si tienes una política RLS de escritura para anon; SERVICE para demo.
SUPABASE_ANON_KEY=

# Tabla destino (recomendado schema sugerido en README)
SUPABASE_TABLE=casos_web

# Requisito mínimo de robots: el worker solo lee RSS/Atom públicos.
# Cualquier scraping adicional deberá respetar robots.txt.